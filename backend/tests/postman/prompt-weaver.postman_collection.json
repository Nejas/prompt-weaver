{
  "info": {
    "name": "Prompt Weaver REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('registered user', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('email')));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('email', 'postman-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      }
    },
    {
      "name": "duplicate registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      }
    },
    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json(); pm.test('tokens returned', () => {pm.expect(j.access_token).to.be.a('string').and.not.empty; pm.expect(j.refresh_token).to.be.a('string').and.not.empty;}); pm.environment.set('access_token',j.access_token); pm.environment.set('refresh_token',j.refresh_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      }
    },
    {
      "name": "current user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('correct account', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('email')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/me"
      }
    },
    {
      "name": "refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j=pm.response.json(); pm.environment.set('old_refresh_token',pm.environment.get('refresh_token')); pm.environment.set('access_token',j.access_token); pm.environment.set('refresh_token',j.refresh_token); pm.test('tokens rotated',()=>pm.expect(j.refresh_token).not.to.eql(pm.environment.get('old_refresh_token')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\": \"{{refresh_token}}\"}"
        }
      }
    },
    {
      "name": "old refresh rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\": \"{{old_refresh_token}}\"}"
        }
      }
    },
    {
      "name": "logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\": \"{{refresh_token}}\"}"
        }
      }
    },
    {
      "name": "revoked session rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/me"
      }
    },
    {
      "name": "catalog",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('demo template exists',()=>pm.expect(pm.response.json().templates.some(t=>t.id===pm.environment.get('template_id'))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/templates"
      }
    },
    {
      "name": "template details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('parameters returned',()=>pm.expect(pm.response.json().parameters.map(p=>p.name)).to.include.members(['request','level']));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/templates/{{template_id}}"
      }
    },
    {
      "name": "missing template",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/templates/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "invalid pagination",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/templates?limit=101"
      }
    },
    {
      "name": "rules",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('rules returned',()=>pm.expect(pm.response.json().rules).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/rule-sets/teaching-basics-v1"
      }
    },
    {
      "name": "missing rules",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/rule-sets/missing"
      }
    },
    {
      "name": "compose",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('values substituted',()=>pm.expect(pm.response.json().prompt).to.include('recursion'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/prompts/compose",
        "body": {
          "mode": "raw",
          "raw": "{\"template_version_id\": \"{{template_id}}\", \"parameters\": {\"request\": \"recursion\", \"level\": \"начальный\"}}"
        }
      }
    },
    {
      "name": "required parameter",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/prompts/compose",
        "body": {
          "mode": "raw",
          "raw": "{\"template_version_id\": \"{{template_id}}\", \"parameters\": {\"level\": \"начальный\"}}"
        }
      }
    },
    {
      "name": "compose with rules",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('rules applied',()=>pm.expect(pm.response.json().prompt).to.include('Инструкции сценария'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/prompts/compose-with-rules",
        "body": {
          "mode": "raw",
          "raw": "{\"template_version_id\": \"{{template_id}}\", \"parameters\": {\"request\": \"recursion\", \"level\": \"начальный\"}, \"rule_set_id\": \"teaching-basics-v1\"}"
        }
      }
    },
    {
      "name": "compose scenario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('configured rules selected',()=>pm.expect(pm.response.json().rule_set_id).to.eql('teaching-basics-v1'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/prompts/compose-scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"template_version_id\": \"{{template_id}}\", \"parameters\": {\"request\": \"recursion\", \"level\": \"начальный\"}}"
        }
      }
    }
  ]
}